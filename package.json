{
    "name": "musichub",
    "productName": "Blueberry Music Player",
    "version": "1.0.0",
    "description": "This is a music player built with Electron.",
    "license": "ISC",
    "author": "Makiato",
    "type": "commonjs",
    "main": "main.js",
    "scripts": {
        "dev": "nodemon --exec electron .",
        "start": "electron .",
        "clean": "rimraf dist",
        "build": "npm run clean && electron-builder build --win --publish never"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@tanstack/virtual-core": "^3.14.0",
        "electron": "^41.0.4",
        "electron-builder": "^26.8.1",
        "eslint": "^10.2.0",
        "ffmpeg-static": "^5.3.0",
        "fluent-ffmpeg": "^2.1.3",
        "globals": "^17.4.0",
        "howler": "^2.2.4",
        "jsmediatags": "^3.9.7",
        "lucide": "^1.7.0",
        "nodemon": "^3.1.14",
        "prettier": "3.8.1",
        "rimraf": "^6.1.3",
        "store": "^2.0.12",
        "sortablejs": "^1.15.7"
    },
    "dependencies": {
        "electron-store": "^11.0.2"
    },
    "build": {
        "appId": "com.makiato.musichub",
        "removePackageScripts": true,
        "npmRebuild": false,
        "nodeGypRebuild": false,
        "directories": {
            "buildResources": "build-assets",
            "output": "dist"
        },
        "files": [
            "main.js",
            "preload.js",
            "ui/**/*",
            "package.json",
            "!**/*.md",
            "!**/*.log",
            "!nodemon.json",
            "!package-lock.json",
            "!dist/**",
            "!build-assets/**",
            "!Executable/**",
            "!docs/**",
            "!**/test/**",
            "!**/tests/**",
            "!**/tests/**",
            "!**/docs/**",
            "!**/*.map",
            "!**/node_modules/*/{CHANGELOG.md,README.md,readme.md,readme.txt}",
            "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
            "!**/node_modules/*.d.ts",
            "!**/node_modules/**/*.map",
            "!**/node_modules/.bin/**",
            "!**/node_modules/lucide/dist/esm/**",
            "!**/node_modules/lucide/dist/umd/**"
        ],
        "electronLanguages": [
            "en-US",
            "vi"
        ],
        "extraFiles": [],
        "asarUnpack": [],
        "asar": true,
        "compression": "maximum",
        "win": {
            "target": "nsis",
            "icon": "IMG_4980.PNG"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "deleteAppDataOnUninstall": true
        }
    }
}
